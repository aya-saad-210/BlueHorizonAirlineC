# Copy this file to Rag/.env (or a root .env) and fill in real values.
# NEVER commit the filled-in .env -- it's covered by the root .gitignore.

# Embedding backend. "local" (default) needs no key and works fully
# offline -- see Rag/embeddings.py for why. Set to "gemini" to use the
# real gemini-embedding-001 endpoint instead (requires GEMINI_API_KEY
# below; rebuild the vector store after switching, dimensions differ).
EMBEDDING_PROVIDER=local

# Optional. If set, Rag/llm_client.py (and planning/llm_client.py) switch
# from their deterministic mock mode to real Gemini API calls for answer
# generation, agentic reasoning, Self-RAG relevance/support judging, and
# every planning algorithm's LLM calls. Leave unset to run the whole
# pipeline (ingest -> retrieve -> generate -> verify) offline for local
# development and grading without spending API credits. Get a free key
# (no credit card) at https://aistudio.google.com.
GEMINI_API_KEY=AQ.Ab8RN6LE2W6b-EfYEkP8_N1DLL07bFEMNJLeohkEcg59KRbQKA

# Optional, defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional, planning/ only -- overrides GEMINI_MODEL just for the
# planning agent if you want a different/cheaper model there.
PLANNING_GEMINI_MODEL=gemini-flash-lite-latest

# Optional, minimum seconds between consecutive live API calls (both
# Rag/llm_client.py and planning/llm_client.py). Defaults to 4.5s, tuned
# for Gemini's commonly-reported free-tier Flash limit (~10-15 requests/
# minute as of mid-2026). Check your actual limit at
# https://aistudio.google.com and raise this if you still see 429s, or
# lower it if you're on a paid tier with higher throughput.
GEMINI_MIN_CALL_INTERVAL_S=4.5
