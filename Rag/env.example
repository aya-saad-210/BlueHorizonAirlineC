# Copy this file to rag/.env (or a root .env) and fill in real values.
# NEVER commit the filled-in .env -- it's covered by the root .gitignore.

# Embedding backend. "local" (default) needs no key and works fully
# offline -- see rag/embeddings.py for why. Set to "anthropic" only after
# implementing AnthropicEmbeddingBackend against a real provider.
EMBEDDING_PROVIDER=local

# Optional. If set, rag/llm_client.py switches from its deterministic mock
# mode to real Anthropic API calls for answer generation, agentic
# reasoning, and Self-RAG relevance/support judging. Leave unset to run
# the whole pipeline (ingest -> retrieve -> generate -> verify) offline
# for local development and grading without spending API credits.
ANTHROPIC_API_KEY=

# Optional, defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6
